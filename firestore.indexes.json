      "fields": [
        { "fieldPath": "season", "order": "ASCENDING" },
        { "fieldPath": "round", "order": "ASCENDING" },
        { "fieldPath": "kickoff", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "rounds",
      "queryScope": "COLLECTION",
